# Copy to .env and edit. .env is gitignored — never commit real values.
#   cp platform/local/.env.example platform/local/.env

# Local stack credentials. These are development-only defaults; they are
# deliberately weak and must never be reused against anything reachable.
POSTGRES_PASSWORD=mlops_dev_only
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GRAFANA_PASSWORD=admin

# Set to "false" only when you are running the lineage profile (Marquez up).
# With Marquez down, Airflow retries the lineage POST on every task and floods
# the logs, so it ships disabled.
OPENLINEAGE_DISABLED=true

# ---- Azure (Projects 1, 3, 4 burst runs) ----------------------------------
# Find your subscription id with:  az account show --query id -o tsv
ARM_SUBSCRIPTION_ID=
TF_VAR_subscription_id=

# Globally unique across all of Azure. You already own this one.
TF_VAR_acr_name=wahabmlopsacr
